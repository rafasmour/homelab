DOMAIN=tomandjerry.mourou.dev
N8N_VERSION=latest
N8N_MCP_VERSION=latest
POSTGRES_VERSION=16-alpine
TZ=Etc/UTC
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME
# The owner account is created in the browser on first launch.

# Create in n8n: Settings > n8n API > Create an API key.
N8N_API_KEY=CHANGE_ME
# Must match hermes/N8N_MCP_AUTH_TOKEN. Generate with: openssl rand -hex 32
N8N_MCP_AUTH_TOKEN=CHANGE_ME

# Password for the Piraeus statement zip.
PIRAEUS_ZIP_PASSWORD=CHANGE_ME
# CSV text encoding inside the zip (default: auto-detect; Piraeus GR is usually win1253).
# PIRAEUS_CSV_ENCODING=win1253
# Must match firefly-iii/AUTO_IMPORT_SECRET. Generate with: openssl rand -hex 16
AUTO_IMPORT_SECRET=CHANGE_ME
# Firefly asset account id for piraeus-current.csv when imports/_fallback.json is absent.
FIREFLY_IMPORT_DEFAULT_ACCOUNT_ID=1


