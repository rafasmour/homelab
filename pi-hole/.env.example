DOMAIN=tomandjerry.mourou.dev
TZ=Etc/UTC
PUID=1000
PGID=1000
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=1.0.0.1

# LAN address of this Docker host. Binding DNS to this address avoids the
# systemd-resolved listeners on 127.0.0.53 and 127.0.0.54.
PIHOLE_BIND_IP=192.168.1.10

# WireGuard address on which Pi-hole should also answer DNS queries.
PIHOLE_WIREGUARD_BIND_IP=10.15.0.3

# Pi-hole v6 stores a double SHA-256 hash, not the plaintext password.
# Generate with: printf '%s' 'CHANGE_ME' | openssl dgst -sha256 -hex | awk '{print $2}' | openssl dgst -sha256 -hex | awk '{print $2}'
WEBPASSWORD=CHANGE_ME
