# PostgreSQL superuser (postgres). Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_IMAGE_TAG=17-vectorchord0.4.3-pgvector0.8.1
# POSTGRES_MEM_LIMIT=1536m

# MariaDB root password (Nextcloud). Only used when ./mariadb is initialised.
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_VERSION=lts
# MARIADB_MEM_LIMIT=512m
