version = 1

; Command-line options override these values. Keep model-execution options here.
;
; GPU profile: RX 7900 XT (gfx1100, 20 GiB VRAM, ROCm/HIP), host RAM 15 GB.
; Budget rule: every preset uses at most ~16 GiB of VRAM (weights + KV cache +
; compute buffers), measured with /sys/class/drm/card1/device/mem_info_vram_used
; after loading, which leaves headroom for the desktop and other GPU users.
;   ctx-size      = min(native context_length from the GGUF, 262144)
;   parallel      = 1 (one slot gets the whole context)
;   KV cache      = q8_0, or q4_0 where q8_0 does not fit
;   fit = off     the explicit n-gpu-layers / n-cpu-moe values below are the
;                 measured budget; --fit would grow into all free VRAM
;   n-cpu-moe     MoE presets keep the experts of the first N layers in RAM;
;                 CPU-resident experts stay at or below ~6 GB of the 15 GB RAM
; Small dense models also use draftless n-gram speculation (spec-type =
; ngram-mod): when the context repeats (code edits, quotes) one weight read
; yields several tokens. Vision presets skip it.
;
; The router lists models alphabetically in /v1/models, not in file order, so
; clients must name the model explicitly (Hermes: mellum-2.1-12b-a2.5b).

[*]
flash-attn = on
fit = off
n-gpu-layers = all
threads = 8
threads-batch = 16
parallel = 1
kv-unified = true
ctx-size = 262144
cache-type-k = q8_0
cache-type-v = q8_0
batch-size = 1024
ubatch-size = 512
repeat-penalty = 1.0
; Host-RAM prompt cache (default 8192 MiB); kept small because CPU-resident
; experts and the other stacks already share the 15 GB of RAM.
cache-ram = 2048
; Read GGUFs with Direct I/O instead of mmap: the models are larger than the
; 15 GB of RAM, so page-cached mmap loads thrash and crawl.
load-mode = dio

[mellum-2.1-12b-a2.5b]
; JetBrains Mellum 2.1 (12B MoE, 2.5B active), thinking variant, Q6_K, fully
; on the GPU. Native context is 131072 (8192 with YaRN x16 built in). It serves
; Hermes chat, Talk rooms, cron and Open WebUI at once: 4 slots of 96k with f16
; KV (kv-unified off). Measured 16.65 GiB and ~102 tok/s; q8_0 KV with 6 x 128k
; used 18.36 GiB and ran at ~44 tok/s, because ROCm flash attention is much
; slower on a quantized KV cache.
model = /models/mellum/mellum-2.1-12b-a2.5b/Mellum2.1-12B-A2.5B-Thinking-Q6_K.gguf
; plan: f16 KV, 96k per slot x 4 slot(s)
ctx-size = 393216
parallel = 4
kv-unified = false
cache-type-k = f16
cache-type-v = f16
; Mellum is a thinking model: it reasoned 500-2800 tokens before every tool
; call (44 tok/s, 30-60 s per step), so a food log took 3-5 minutes. Cap it;
; 512 cut thoughts off mid-sentence and they leaked into the reply.
reasoning-budget = 1024
reasoning-budget-message = Enough thinking. Act now: call the next tool or answer.
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
temp = 0.6
top-p = 0.95
top-k = 20

[flint-40b-a2.5b]
; RecursiveSI Flint (40B MoE, 2.5B active, 256 experts), Unsloth UD-Q3_K_XL.
; No Q4 file fits the budget: UD-Q4_K_XL (23.3 GB) would need ~9 GB of experts
; in RAM. Vendor sampling: temp 1.0 / top-p 0.95 / top-k 20.
model = /models/flint/flint-40b-a2.5b/flint-UD-Q3_K_XL.gguf
; plan: q8_0 KV, 96k per slot x 1 slot(s)
ctx-size = 98304
parallel = 1
kv-unified = true
cache-type-k = q8_0
cache-type-v = q8_0
n-cpu-moe = 4
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
temp = 1.0
top-p = 0.95
top-k = 20
min-p = 0.0

[gemma-4-12b-it-qat]
model = /models/gemma/gemma-4-12b-it-qat/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
; plan: f16 KV, 128k per slot x 4 slot(s)
ctx-size = 524288
parallel = 4
kv-unified = false
cache-type-k = f16
cache-type-v = f16
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
temp = 1.0
top-p = 0.95
top-k = 64

[gemma-4-12b-it-qat-vision]
model = /models/gemma/gemma-4-12b-it-qat/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
mmproj = /models/gemma/gemma-4-12b-it-qat/mmproj-F16.gguf
; plan: f16 KV, 128k per slot x 4 slot(s)
ctx-size = 524288
parallel = 4
kv-unified = false
cache-type-k = f16
cache-type-v = f16
temp = 1.0
top-p = 0.95
top-k = 64

[gemma-4-26b-a4b]
model = /models/gemma/gemma-4-26b-a4b/gemma-4-26B-A4B-it-Q4_0.gguf
; plan: q8_0 KV, 128k per slot x 2 slot(s)
ctx-size = 262144
parallel = 2
kv-unified = false
cache-type-k = q8_0
cache-type-v = q8_0
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
temp = 1.0
top-p = 0.95
top-k = 64

[gemma-4-26b-a4b-vision]
model = /models/gemma/gemma-4-26b-a4b/gemma-4-26B-A4B-it-Q4_0.gguf
mmproj = /models/gemma/gemma-4-26b-a4b/mmproj-gemma-4-26B-A4B-it-Q8_0.gguf
; plan: q8_0 KV, 128k per slot x 2 slot(s)
ctx-size = 262144
parallel = 2
kv-unified = false
cache-type-k = q8_0
cache-type-v = q8_0
temp = 1.0
top-p = 0.95
top-k = 64

[gemma-4-31b-it]
; Dense 31B, Unsloth UD-IQ3_XXS, fully on the GPU.
model = /models/gemma/gemma-4-31b-it/gemma-4-31B-it-UD-IQ3_XXS.gguf
; plan: q8_0 KV, 128k per slot x 1 slot(s)
ctx-size = 131072
parallel = 1
kv-unified = true
cache-type-k = q8_0
cache-type-v = q8_0
temp = 1.0
top-p = 0.95
top-k = 64

[gemma-4-31b-it-vision]
model = /models/gemma/gemma-4-31b-it/gemma-4-31B-it-UD-IQ3_XXS.gguf
mmproj = /models/gemma/gemma-4-31b-it/mmproj-F16.gguf
; plan: q8_0 KV, 96k per slot x 1 slot(s)
ctx-size = 98304
parallel = 1
kv-unified = true
cache-type-k = q8_0
cache-type-v = q8_0
temp = 1.0
top-p = 0.95
top-k = 64

[hy-memory-30b-a3b]
; Tencent Hy-Memory (30B MoE, 3B active, 48 full-attention layers). Q3_K_M:
; the KV cache at 262144 tokens is large, so Q4_K_M would need ~9 GB of
; experts in RAM. Vendor settings: no-think, temp 0.7, top-k 0, top-p 1.0.
model = /models/hy/hy-memory-30b-a3b/Hy-Memory-30B-A3B-Q3_K_M.gguf
; plan: q8_0 KV, 96k per slot x 1 slot(s)
ctx-size = 98304
parallel = 1
kv-unified = true
cache-type-k = q8_0
cache-type-v = q8_0
n-cpu-moe = 20
chat-template-kwargs = {"reasoning_effort":"no_think"}
temp = 0.7
top-k = 0
top-p = 1.0

[lfm-2.5-8b-a1b]
model = /models/lfm/lfm-2.5-8b-a1b/LFM2.5-8B-A1B-Q4_K_M.gguf
; plan: f16 KV, 125k per slot x 8 slot(s)
ctx-size = 1024000
parallel = 8
kv-unified = false
cache-type-k = f16
cache-type-v = f16
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
temp = 0.2
top-k = 80
repeat-penalty = 1.05

[lfm-2.5-24b-a2b]
; Official LiquidAI GGUF. 24B MoE (2B active), 40 layers: 30 short-conv + 10 GQA.
model = /models/lfm/lfm-2.5-24b-a2b/LFM2.5-24B-A2B-Q4_K_M.gguf
; plan: f16 KV, 96k per slot x 2 slot(s)
ctx-size = 196608
parallel = 2
kv-unified = false
cache-type-k = f16
cache-type-v = f16
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
; LiquidAI recommended sampling.
temp = 0.1
top-k = 50
repeat-penalty = 1.05

[minicpm5-2b]
model = /models/minicpm/minicpm5-2b/MiniCPM5-2B-Q8_0.gguf
; plan: f16 KV, 96k per slot x 4 slot(s)
ctx-size = 393216
parallel = 4
kv-unified = false
cache-type-k = f16
cache-type-v = f16
batch-size = 2048
ubatch-size = 1024
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
; Vendor (openbmb/MiniCPM5-2B) recommended: temp 1.0, top_p 0.95, min_p 0.0.
; min_p 0.0 is explicit: llama.cpp's default 0.05 can cause repetitive output.
temp = 1.0
top-p = 0.95
min-p = 0.0

[qwen-3.6-35b-a3b]
model = /models/qwen/qwen-3.6-35b-a3b/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf
; plan: q8_0 KV, 128k per slot x 1 slot(s)
ctx-size = 131072
parallel = 1
kv-unified = true
cache-type-k = q8_0
cache-type-v = q8_0
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
temp = 1.0
top-p = 0.95
top-k = 20
min-p = 0
presence-penalty = 1.5

[qwen-3.8-27b]
; Dense 27B, Q4_0 (14.94 GiB), all 65 layers on the GPU: CPU layers also move
; their KV cache to RAM, and a 262144-token run with 15-21 CPU layers was
; OOM-killed on this 15 GB host. Context is sized with a q4_0 KV cache instead.
; KV estimate from GGUF metadata: 64 layers, full_attention_interval 4 -> 16
; full-attention layers (the 48 Gated DeltaNet layers keep a fixed ~150 MiB
; recurrent state) x 4 KV heads x 256 dims x 2 (K+V) x 0.5625 B (q4_0)
; = 18 KiB/token. GPU weights 14617 MiB (file minus the 682 MiB token_embd,
; which stays in RAM) + ~150 MiB state + ~800 MiB compute leave ~800 MiB of
; the 16384 MiB budget -> ~45K tokens at most; 32768 keeps a margin.
; PROVISIONAL: estimate only, measure after the reboot and raise if it fits.
model = /models/qwen/qwen-3.8-27b/Qwen3.8-27B-Q4_0.gguf
; plan: q8_0 KV, 96k per slot x 1 slot(s)
ctx-size = 98304
parallel = 1
kv-unified = true
cache-type-k = q8_0
cache-type-v = q8_0
n-gpu-layers = all
temp = 1.0
top-p = 0.95
top-k = 20
min-p = 0.0
presence-penalty = 0.0

[qwen-3.8-27b-mtp]
; Same model with its 1.28 GiB MTP head, all on the GPU, q4_0 KV.
; PROVISIONAL and OVER BUDGET by estimate: weights alone are 14.3 GiB, so
; with the head this is ~16.8 GiB at 16384 tokens (fits the 20 GiB card, not
; the 16 GiB rule; no ctx-size gets it under 16 GiB with every layer on the
; GPU). Measure after the reboot; to meet the rule, set n-gpu-layers = 60
; (~1.1 GB of weights + KV in RAM).
model = /models/qwen/qwen-3.8-27b/Qwen3.8-27B-Q4_0.gguf
model-draft = /models/qwen/qwen-3.8-27b/MTP/mtp-Qwen3.8-27B-Q4_0.gguf
; plan: q8_0 KV, 68k per slot x 1 slot(s)
ctx-size = 69632
parallel = 1
kv-unified = true
cache-type-k = q8_0
cache-type-v = q8_0
n-gpu-layers = all
spec-type = draft-mtp
spec-draft-n-max = 3
; The MTP draft defaults to ngl auto and f16 KV; keep it entirely on the GPU.
spec-draft-ngl = all
spec-draft-type-k = q8_0
spec-draft-type-v = q8_0
temp = 1.0
top-p = 0.95
top-k = 20
min-p = 0.0
presence-penalty = 0.0

; DISABLED: with the DFlash2 draft, Qwen 3.8 27B no longer fits above 64k fully on the GPU
; (72k: 19.97 GiB, failed to load). The MTP preset is faster (57 tok/s at 68k) and fits.
; [qwen-3.8-27b-dflash2]
; ; DFlash2 block-diffusion drafter (incoai, Q4_K_M, 1.06 GiB; 5 layers x 8 KV
; ; heads x 128 dims), all on the GPU, q4_0 KV.
; ; PROVISIONAL and OVER BUDGET by estimate (~16.6 GiB at 16384 tokens), as for the MTP preset.
; model = /models/qwen/qwen-3.8-27b/Qwen3.8-27B-Q4_0.gguf
; model-draft = /models/qwen/qwen-3.8-27b/Qwen3.8-27B-DFlash2-Q4_K_M.gguf
; ; plan: q8_0 KV, 72k per slot x 1 slot(s)
; ctx-size = 73728
; parallel = 1
; kv-unified = true
; cache-type-k = q8_0
; cache-type-v = q8_0
; n-gpu-layers = all
; spec-type = draft-dflash
; spec-draft-n-max = 7
; temp = 1.0
; top-p = 0.95
; top-k = 20
; min-p = 0.0
; presence-penalty = 0.0

[spark-x2.6-4b]
; XHToken Spark-X2.6-4B (spark2_5 architecture), Q8_0. Native context is
; 1048576; capped at 262144. Vendor sampling: temp 1.0 / top-p 0.95 / no top-k.
model = /models/spark/spark-x2.6-4b/Spark-X2.6-4B-Q8_0.gguf
; plan: f16 KV, 96k per slot x 3 slot(s)
ctx-size = 294912
parallel = 3
kv-unified = false
cache-type-k = f16
cache-type-v = f16
batch-size = 2048
ubatch-size = 1024
spec-type = ngram-mod
spec-ngram-mod-n-match = 24
spec-ngram-mod-n-min = 48
spec-ngram-mod-n-max = 64
temp = 1.0
top-p = 0.95
top-k = 0
min-p = 0.0
presence-penalty = 0.0
