DOMAIN=example.com
# Parallel compile jobs; empty uses every CPU thread. Set a number if the
# build runs out of RAM (HIP compiles can take 1-2 GB each).
MAX_JOBS=
MAX_MODELS=1
SLEEP_IDLE_SECONDS=300

# Context, unified KV, and slot count are router-preset keys, not Compose
# flags. models/router-config.ini sets ctx-size=262144, kv-unified=true, and
# parallel=4. A command-line -c, --kv-unified, or --parallel would override
# the ini; this stack does not pass those flags.
# Use current upstream main for new model and speculative-decoding support.
# Pin a tested commit here when reproducibility is more important.
# K2-Horizon models require the MBZUAI-IFM fork until upstream merges support:
# LLAMA_REPO=https://github.com/MBZUAI-IFM/llama.cpp
# LLAMA_REF=model/K2Horizon
LLAMA_REF=main
