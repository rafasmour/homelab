#!/usr/bin/env bash
# sandbox - friendly front end for agent-sandbox (sessions of Hermes or pi in throwaway containers).
#
#   sandbox                         menu: start a session or manage sessions
#   sandbox start [HARNESS [PROFILE]] [options]
#        -C DIR            working folder (default: current folder)
#        -m, --modules L   comma-separated modules ("none" for no modules)
#        --unrestricted    internet, git, docker, testbed (and websearch for pi) on
#        -d, --detach      start in the background
#        -p, --prompt T    first prompt        --dry-run   only print the command
#        --yes             skip the confirmation (a terminal is still needed unless -d)
#        -- ARGS           passed to the harness
#   sandbox ls|attach|logs|stop|build ...   same as agent-sandbox
#
# agent-sandbox is a separate local repo (AGENT_SANDBOX_DIR, default ../agent-sandbox
# next to this checkout, or the agent-sandbox found on PATH). Uses whiptail on a
# terminal, numbered prompts otherwise.

set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
AS_DIR="${AGENT_SANDBOX_DIR:-$HERE/../agent-sandbox}"
if [ -x "$AS_DIR/agent-sandbox" ]; then AS="$(cd "$AS_DIR" && pwd)/agent-sandbox"
elif command -v agent-sandbox >/dev/null 2>&1; then AS="$(command -v agent-sandbox)"
else AS=""; fi

die() { echo "sandbox: $*" >&2; exit 1; }
usage() { sed -n '2,19p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# ---------------------------------------------------------------- UI layer
UI=plain
if [ "${SANDBOX_UI:-}" != plain ] && [ -t 0 ] && [ -t 1 ] && command -v whiptail >/dev/null 2>&1; then UI=whiptail; fi
TITLE="Agent sandbox"
cancel() { echo "sandbox: cancelled" >&2; exit 1; }

ui_msg() {
  if [ "$UI" = whiptail ]; then whiptail --title "$TITLE" --msgbox "$1" 20 78 || true; else printf '\n%s\n' "$1"; fi
}

ui_yesno() {  # TEXT [y|n default]
  if [ "$UI" = whiptail ]; then
    local d=(); [ "${2:-y}" = n ] && d=(--defaultno)
    whiptail --title "$TITLE" "${d[@]}" --yesno "$1" 20 78
  else
    local a; read -r -p "$1 [${2:-y}] " a || return 1
    a="${a:-${2:-y}}"; [[ "$a" =~ ^[Yy] ]]
  fi
}

ui_input() {  # PROMPT DEFAULT
  if [ "$UI" = whiptail ]; then
    whiptail --title "$TITLE" --inputbox "$1" 10 78 "$2" 3>&1 1>&2 2>&3 || cancel
  else
    local a; read -r -p "$1 [$2] " a || cancel; echo "${a:-$2}"
  fi
}

ui_menu() {  # PROMPT tag desc ... -> tag
  local prompt="$1"; shift
  if [ "$UI" = whiptail ]; then
    local h=$(( $# / 2 )); [ "$h" -le 12 ] || h=12
    local lines; lines=$(printf '%s\n' "$prompt" | wc -l)
    whiptail --title "$TITLE" --menu "$prompt" $((h + lines + 7)) 100 "$h" "$@" 3>&1 1>&2 2>&3 || cancel
  else
    local tags=() descs=() i a
    while [ $# -gt 0 ]; do tags+=("$1"); descs+=("$2"); shift 2; done
    { printf '\n%s\n' "$prompt"
      for ((i = 0; i < ${#tags[@]}; i++)); do printf '  %2d) %-18s %s\n' $((i + 1)) "${tags[i]}" "${descs[i]}"; done; } >&2
    while :; do
      read -r -p "number [1] " a || cancel; a="${a:-1}"
      if [[ "$a" =~ ^[0-9]+$ ]] && [ "$a" -ge 1 ] && [ "$a" -le "${#tags[@]}" ]; then echo "${tags[a-1]}"; return; fi
      echo "invalid" >&2
    done
  fi
}

ui_check() {  # PROMPT tag desc ON|OFF ... -> space separated tags
  local prompt="$1"; shift
  if [ "$UI" = whiptail ]; then
    local h=$(( $# / 3 )); [ "$h" -le 12 ] || h=12
    local out
    out="$(whiptail --title "$TITLE" --separate-output --checklist "$prompt (space toggles, enter confirms)" \
      $((h + 8)) 100 "$h" "$@" 3>&1 1>&2 2>&3)" || cancel
    echo "${out//$'\n'/ }"
  else
    local tags=() descs=() states=() i a sel=()
    while [ $# -gt 0 ]; do tags+=("$1"); descs+=("$2"); states+=("$3"); shift 3; done
    { printf '\n%s\n' "$prompt"
      for ((i = 0; i < ${#tags[@]}; i++)); do
        printf '  %2d) [%s] %-12s %s\n' $((i + 1)) "$([ "${states[i]}" = ON ] && echo x || echo ' ')" "${tags[i]}" "${descs[i]}"
      done; } >&2
    read -r -p "numbers separated by spaces, 'a' = all, 'n' = none, empty = keep marked: " a || cancel
    case "$a" in
      "") for ((i = 0; i < ${#tags[@]}; i++)); do if [ "${states[i]}" = ON ]; then sel+=("${tags[i]}"); fi; done ;;
      a) sel=("${tags[@]}") ;;
      n) ;;
      *) for i in $a; do
           if [[ "$i" =~ ^[0-9]+$ ]] && [ "$i" -ge 1 ] && [ "$i" -le "${#tags[@]}" ]; then sel+=("${tags[i-1]}"); fi
         done ;;
    esac
    echo "${sel[*]:-}"
  fi
}

# ---------------------------------------------------------------- agent-sandbox introspection
need_as() { [ -n "$AS" ] || die "agent-sandbox not found (looked in $AS_DIR and on PATH). It is a separate local repo with no remote: copy it next to the homelab checkout or set AGENT_SANDBOX_DIR, then rerun scripts/install-cli.sh."; }

harnesses() { "$AS" --help 2>&1 | sed -n 's/^Harnesses: *//p' | head -1; }

profiles() {  # HARNESS -> "name<TAB>description"
  "$AS" "$1" -h 2>&1 | awk '/^Profiles:/ {on=1; next} on && /^  [^ ]/ {n=$1; $1=""; sub(/^ +/,""); print n "\t" $0; next} on {on=0}'
}

# HARNESS PROFILE -> "name<TAB>description<TAB>ON|OFF" (profile defaults)
modules() {
  "$AS" "$1" -h 2>&1 | awk -v prof="$2" '
    /^Modules/ {on=1; next}
    on && /^  [a-z]/ {
      if (match($0, /(on|off) +\/ +(on|off) *$/)) {
        t = substr($0, RSTART); split(t, f, /[ \/]+/)
        d = (prof == "devops") ? f[2] : f[1]
        line = $0; sub(/ +(on|off) +\/ +(on|off) *$/, "", line)
        name = $1; sub(/^ +[^ ]+ +/, "", line)
        print name "\t" line "\t" (d == "on" ? "ON" : "OFF")
      }
      next }
    on && !/^  / {on=0}'
}

# ---------------------------------------------------------------- command assembly
CMD=()
build_cmd() {  # H P FOLDER MODS UNRESTRICTED DETACH PROMPT EXTRA(array string)
  CMD=(agent-sandbox "$H")
  [ -z "$P" ] || CMD+=("$P")
  if [ "$UNRESTRICTED" = 1 ]; then CMD+=(--unrestricted)
  elif [ -n "$MODS" ]; then CMD+=(-m "$MODS"); fi
  [ "$DETACH" = 0 ] || CMD+=(-d)
  [ -z "$PROMPT" ] || CMD+=(-p "$PROMPT")
  if [ -n "$EXTRA" ]; then local ex; read -ra ex <<<"$EXTRA"; CMD+=(-- "${ex[@]}"); fi
}

shown() {  # printable: cd FOLDER && command
  local out="" a
  for a in "${CMD[@]}"; do if [[ "$a" =~ ^[A-Za-z0-9_@%+=:,./-]+$ ]]; then out+="$a "; else out+="$(printf '%q' "$a") "; fi; done
  printf 'cd %q && %s' "$FOLDER" "${out% }"
}

launch() {
  echo "+ $(shown)"
  [ "$DRY" = 0 ] || { echo "(dry run: nothing started)"; return 0; }
  cd "$FOLDER"
  exec "$AS" "${CMD[@]:1}"
}

check_modules() {
  case ",$MODS," in *,docker,*compose,*|*,compose,*docker,*) die "docker and compose are mutually exclusive" ;; esac
}

confirm_start() {
  local text="Harness:  $H
Profile:  ${P:-(asked by agent-sandbox)}
Folder:   $FOLDER
Modules:  $([ "$UNRESTRICTED" = 1 ] && echo 'unrestricted (internet, git, docker, testbed)' || echo "${MODS:-(asked by agent-sandbox)}")
Mode:     $([ "$DETACH" = 1 ] && echo 'background (detached)' || echo 'attached to this terminal (detach with Ctrl+\)')
Prompt:   ${PROMPT:-(none)}
Extra:    ${EXTRA:-(none)}
$(case ",$MODS," in *,docker,*) echo; echo 'WARNING: docker gives the agent the host Docker socket (root-equivalent).' ;; esac)
Equivalent command:
  $(shown)"
  case "$(ui_menu "$text" run "start the session" dry "dry run: only print the command" cancel "cancel")" in
    run) ;;
    dry) DRY=1 ;;
    *) cancel ;;
  esac
}

# ---------------------------------------------------------------- wizards
wizard_start() {
  local hs h items=() hl
  hs="$(harnesses)"; [ -n "$hs" ] || die "could not read the harness list from agent-sandbox --help"
  for h in $hs; do items+=("$h" "start $h"); done
  H="$(ui_menu "Harness" "${items[@]}")"

  items=(); local pn pd
  while IFS=$'\t' read -r pn pd; do items+=("$pn" "$pd"); done < <(profiles "$H")
  [ ${#items[@]} -gt 0 ] || die "no profiles reported for $H"
  P="$(ui_menu "Profile" "${items[@]}")"

  FOLDER="$(ui_input "Working folder (mounted into the sandbox at the same path)" "$PWD")"
  FOLDER="${FOLDER/#\~/$HOME}"
  [ -d "$FOLDER" ] || die "folder not found: $FOLDER"
  FOLDER="$(cd "$FOLDER" && pwd)"

  UNRESTRICTED=0 MODS=""
  if [ "$(ui_menu "Permissions" pick "choose the modules (recommended)" unrestricted "everything on: internet, git, docker, testbed")" = unrestricted ]; then
    UNRESTRICTED=1
  else
    local mitems=() mn md ms sel
    while IFS=$'\t' read -r mn md ms; do mitems+=("$mn" "${md:0:70}" "$ms"); done < <(modules "$H" "$P")
    [ ${#mitems[@]} -gt 0 ] || die "no modules reported for $H"
    sel="$(ui_check "Modules for $H/$P (profile defaults are marked)" "${mitems[@]}")"
    MODS="${sel// /,}"; MODS="${MODS:-none}"
    check_modules
  fi

  DETACH=0 PROMPT="" EXTRA=""
  local opts
  opts="$(ui_check "Extra options" detach "start in the background, attach later with: sandbox attach" OFF \
    prompt "send a first prompt" OFF args "pass extra arguments to the harness (after --)" OFF)"
  case " $opts " in *" detach "*) DETACH=1 ;; esac
  case " $opts " in *" prompt "*) PROMPT="$(ui_input "First prompt" "")" ;; esac
  case " $opts " in *" args "*) EXTRA="$(ui_input "Arguments for $H (one string, e.g. --resume)" "")" ;; esac
  DRY=0
  build_cmd
  confirm_start
  build_cmd
  launch
}

pick_session() {  # [-a] -> name
  local items=() name rest
  while read -r name rest; do
    [ "$name" = SESSION ] || [ -z "$name" ] || items+=("$name" "$rest")
  done < <("$AS" ls "$@" 2>&1)
  [ ${#items[@]} -gt 0 ] || { ui_msg "No sessions found."; return 1; }
  ui_menu "Session" "${items[@]}"
}

wizard_manage() {
  local act s
  act="$(ui_menu "Manage sessions" \
    ls "list running sessions" lsa "list all sessions, also finished ones" \
    attach "watch and steer a session" logs "print a session's output" \
    stop "stop sessions and clean up" build "rebuild the images (pulls base images)")"
  case "$act" in
    ls) exec "$AS" ls ;;
    lsa) exec "$AS" ls -a ;;
    attach) s="$(pick_session)" || return 0; echo "+ agent-sandbox attach $s"; exec "$AS" attach "$s" ;;
    logs) s="$(pick_session -a)" || return 0; echo "+ agent-sandbox logs $s"; exec "$AS" logs "$s" ;;
    stop)
      s="$(pick_session)" || return 0
      ui_yesno "Stop session $s?

Equivalent command:
  agent-sandbox stop $s" y || cancel
      echo "+ agent-sandbox stop $s"; exec "$AS" stop "$s" ;;
    build)
      ui_yesno "Rebuild all images (pulls base images)?

Equivalent command:
  agent-sandbox build" n || cancel
      echo "+ agent-sandbox build"; exec "$AS" build ;;
  esac
}

wizard() {
  case "$(ui_menu "What do you want to do?" start "start a new session" manage "list, attach, logs, stop, build")" in
    start) wizard_start ;;
    manage) wizard_manage ;;
  esac
}

# ---------------------------------------------------------------- non-interactive start
cmd_start() {
  H="${1:-}"; [ $# -eq 0 ] || shift
  P=""
  if [ $# -gt 0 ] && [[ "$1" != -* ]]; then P="$1"; shift; fi
  FOLDER="$PWD" MODS="" UNRESTRICTED=0 DETACH=0 PROMPT="" EXTRA="" DRY=0
  local yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -C) FOLDER="${2:?-C needs a folder}"; shift ;;
      -m|--modules) MODS="${2:?--modules needs a value}"; shift ;;
      --unrestricted) UNRESTRICTED=1 ;;
      -d|--detach) DETACH=1 ;;
      -p|--prompt) PROMPT="${2:?--prompt needs text}"; shift ;;
      --dry-run) DRY=1 ;;
      --yes|-y) yes=1 ;;
      --) shift; EXTRA="$*"; break ;;
      *) die "unknown option $1" ;;
    esac; shift
  done
  [ -d "$FOLDER" ] || die "folder not found: $FOLDER"
  FOLDER="$(cd "$FOLDER" && pwd)"
  [ -n "$H" ] || die "start needs a harness: $(harnesses)"
  check_modules
  build_cmd
  if [ "$yes" = 0 ] && [ "$DRY" = 0 ]; then
    echo "Would run: $(shown)"
    if [ -t 0 ]; then ui_yesno "Start now?" y || cancel; else die "not a terminal; add --yes or --dry-run"; fi
  fi
  launch
}

# ---------------------------------------------------------------- main
case "${1:-}" in
  -h|--help|help) usage ;;
  "") need_as; [ -t 0 ] || [ "${SANDBOX_UI:-}" = plain ] || { usage; exit 2; }; wizard ;;
  start) need_as; shift; cmd_start "$@" ;;
  ls|attach|logs|stop|build) need_as; exec "$AS" "$@" ;;
  *) die "unknown command $1 (see --help)" ;;
esac
