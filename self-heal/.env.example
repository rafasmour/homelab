DOMAIN=lab.rafasmour.com
TZ=Europe/Athens

# Kill switch. 0 = alerts are only logged (no diagnosis, no Talk message) and
# approvals are refused; /heal deny still works. 1 = enabled.
SELF_HEAL_ENABLED=1

# Owner of ./data (state.json). Create it first: mkdir -p self-heal/data
SELF_HEAL_UID=1000
SELF_HEAL_GID=1000

# --- Shared secrets: each must equal the same variable in the named stack ---
# All generated with: openssl rand -hex 32

# Grafana -> POST /grafana. Same value in grafana/.env.
SELF_HEAL_WEBHOOK_SECRET=CHANGE_ME
# hermes-nextcloud-bridge -> POST /approve. Same value in
# hermes-nextcloud-bridge/.env.
SELF_HEAL_APPROVE_SECRET=CHANGE_ME
# Controller -> hermes-api, valid only for the devops-diagnose profile. Same
# value in hermes/.env.
SELF_HEAL_HERMES_KEY=CHANGE_ME
# hermes-api -> self-heal-diagnose-mcp. Same value in hermes/.env.
DIAGNOSE_MCP_TOKEN=CHANGE_ME
# Controller -> bridge POST /deliver. Same value as TALK_DELIVER_SECRET in
# hermes-nextcloud-bridge/.env (and NEXTCLOUD_TALK_DELIVER_SECRET in hermes/.env).
TALK_DELIVER_SECRET=CHANGE_ME

# Token of the dedicated self-heal Talk room (the part after /call/ in the
# room URL). Same value in hermes-nextcloud-bridge/.env. The room must contain
# only the owner and the Hermes bot.
TALK_SELF_HEAL_ROOM=CHANGE_ME

# --- self-heal only ---

# Diagnose MCP -> host-probe. Only in this file. openssl rand -hex 32
HOST_PROBE_TOKEN=CHANGE_ME

# Approval factor. 0 = chat only: the owner replies `fix` in the self-heal room
# and the controller trusts the owner's Talk actor id (set by Nextcloud, not by
# Hermes). 1 = the reply must also carry a 6-digit TOTP code, so a compromised
# Nextcloud account, bridge or bot secret cannot approve anything. With 0 they can
# approve a proposed restart of an allowlisted container (never another action).
SELF_HEAL_REQUIRE_TOTP=0

# TOTP secret, used only when SELF_HEAL_REQUIRE_TOTP=1; still required to be set.
# For /heal approve (RFC 6238, SHA1, 30 s, 6 digits). Base32,
# at least 16 characters. Only in this file and in your authenticator app.
#   python3 -c 'import base64,os;print(base64.b32encode(os.urandom(20)).decode())'
SELF_HEAL_TOTP_SECRET=CHANGE_ME

# Grafana service account token with the Viewer role (Administration ->
# Users and access -> Service accounts). Used only to re-fetch alerts.
SELF_HEAL_GRAFANA_TOKEN=CHANGE_ME

# The only Talk user allowed to approve or deny: users/<Nextcloud user id>.
SELF_HEAL_OWNER_ACTOR=users/CHANGE_ME

# Containers whose logs the diagnosis may read (regex alternation, required).
# List names with: docker ps --format '{{.Names}}'
# Keep out anything whose logs can hold personal data or secrets: vaultwarden,
# firefly-*, *-database, hermes-*, n8n*, self-heal*, nextcloud*, pihole,
# open-webui.
DIAG_LOG_CONTAINERS=traefik|grafana|prometheus|loki|node-exporter|otel-collector|docker-state-exporter|uptime-kuma|autokuma|homepage|llama-server|llama-classifier|llama-models-ui|searxng|web-search-mcp|drawio|drawio-mcp|excalidraw|chartdb|memos|reactive-resume|wger-web|wger-celery-worker|wger-celery-beat|wger-mcp|immich-server|immich-machine-learning|wyoming-piper|wyoming-whisper|self-heal-test

# Containers the controller may restart after approval (regex matched against
# the whole name, required; enforced again by self-heal-restart-proxy, which
# uses PCRE2). Default: every container on this host except the self-heal
# stack itself (restarting the controller or the restart proxy would break the
# action in flight); regenerate after adding a stack with
#   docker ps -a --format '{{.Names}}' | grep -v '^self-heal' | sort -u | paste -sd'|'
# self-heal-test is the opt-in test container (self-heal/docker-compose.test.yml);
# drop it from the list when you remove that container.
# If the controller is ever compromised, anything listed here can be restarted
# without approval; remove names to limit that.
SELF_HEAL_RESTART_ALLOWLIST=agent-testbed|autokuma|benchmark|benchmark-ui|chartdb|docker-state-exporter|drawio|drawio-mcp|excalidraw|firefly-iii|firefly-iii-cron|firefly-iii-database|firefly-iii-data-importer|firefly-mcp|grafana|hermes-api|hermes-nextcloud-bridge|homepage|homepage-docker-proxy|immich-database|immich-machine-learning|immich-server|immich-valkey|llama-classifier|llama-models-ui|llama-server|loki|memos|n8n|n8n-database|n8n-mcp|nextcloud|nextcloud-cron|nextcloud-database|nextcloud-mcp|nextcloud-redis|node-exporter|open-webui|otel-collector|otel-docker-proxy|pihole|prometheus|reactive-resume|reactive-resume-database|sbx-hf-models|sbx-llamacpp|sbx-models|sbx-socket-proxy|searxng|searxng-valkey|traefik|uptime-kuma|uptime-kuma-bootstrap|vaultwarden|web-search-mcp|wger|wger-celery-beat|wger-celery-worker|wger-database|wger-mcp|wger-powersync|wger-redis|wger-web|wyoming-piper|wyoming-whisper|self-heal-test

# Auto-heal (opt-in). 0 = every restart waits for the owner's `fix` in Talk.
# 1 = the controller restarts without approval when ALL hold: the diagnosis
# proposes restart_container with confidence >= SELF_HEAL_AUTO_MIN_CONFIDENCE,
# the target matches SELF_HEAL_RESTART_ALLOWLIST and SELF_HEAL_AUTO_ALLOWLIST
# but not SELF_HEAL_AUTO_DENY, the re-fetched Grafana alert itself is about
# that exact container (label name, container or container_name; an alert
# without one never auto-approves), and the target has had fewer than
# SELF_HEAL_AUTO_MAX_PER_DAY auto-restarts in 24 h. Anything else falls back
# to the normal Talk approval with a note. SELF_HEAL_ENABLED=0 still wins.
SELF_HEAL_AUTO_APPROVE=0
# low | medium | high
SELF_HEAL_AUTO_MIN_CONFIDENCE=high
# Regex alternation matched against the whole name; empty = no restriction
# beyond SELF_HEAL_RESTART_ALLOWLIST.
SELF_HEAL_AUTO_ALLOWLIST=
# Never auto-restarted (regex, whole name); empty = built-in default: every
# *-database, *-db, *redis*, *valkey*, *postgres*, *mariadb*, *mysql* and
# vaultwarden. Setting it REPLACES the default, so repeat those when you do.
SELF_HEAL_AUTO_DENY=
SELF_HEAL_AUTO_MAX_PER_DAY=3

# Limits.
# Same alert (fingerprint) diagnosed at most once per cooldown.
SELF_HEAL_COOLDOWN_SECONDS=3600
# Diagnoses started per hour across all alerts.
SELF_HEAL_MAX_RUNS_PER_HOUR=4
# How long a proposed action can be approved.
SELF_HEAL_APPROVAL_TTL_SECONDS=900

# Hermes call.
SELF_HEAL_HERMES_MODEL=hermes-agent
SELF_HEAL_DIAGNOSE_TIMEOUT=900

# Pinned images.
PYTHON_VERSION=3.13.17
HAPROXY_VERSION=3.2.26-alpine
