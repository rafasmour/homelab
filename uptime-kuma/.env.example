DOMAIN=tomandjerry.mourou.dev
UPTIME_KUMA_VERSION=2
# The administrator account is created in the browser on first launch.
# AutoKuma signs in with this existing Uptime Kuma account to create and update monitors.
# Use the same username and password; neither value is generated by Uptime Kuma nor committed to Git.
AUTOKUMA_KUMA_USERNAME=admin
AUTOKUMA_KUMA_PASSWORD=CHANGE_ME
