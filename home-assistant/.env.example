DOMAIN=tomandjerry.mourou.dev
TZ=Etc/UTC

# Official Home Assistant tag. Upstream recommends the moving stable tag.
HOME_ASSISTANT_VERSION=stable

# Pinned Wyoming images. Override to move either speech container.
WHISPER_VERSION=3.8.1
PIPER_VERSION=2.5.2

# Faster-whisper model and language. The Assist pipeline language must match.
WHISPER_MODEL=tiny-int8
WHISPER_LANGUAGE=en

# Piper voice. No HTTP server is started. Change this only together with WHISPER_LANGUAGE.
PIPER_VOICE=en_US-lessac-medium
