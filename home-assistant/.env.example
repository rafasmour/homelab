DOMAIN=lab.rafasmour.com
TZ=Etc/UTC

# Official Home Assistant tag. Upstream recommends the moving stable tag.
HOME_ASSISTANT_VERSION=stable

# Pinned Wyoming images. Override to move either speech container.
WHISPER_VERSION=3.8.1
PIPER_VERSION=2.5.2

# Speech-to-text (wyoming-whisper, faster-whisper on CPU). The Assist pipeline
# language must match WHISPER_LANGUAGE. The one-shot wyoming-whisper-download
# job fetches the model into ./whisper; the server itself has no internet.
# Measured on this host (Ryzen 7 1800X, 8 threads, beam 1, int8), per 3-5 s
# command: base.en ~1.0 s, small.en ~3.4 s, tiny-int8 is less accurate.
# Any faster-whisper name works (tiny.en, base.en, small.en, distil-small.en,
# medium.en) as do tiny/base/small/medium-int8 and Hugging Face repo ids.
# WHISPER_STT_LIBRARY=sherpa with WHISPER_MODEL=sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8
# selects NVIDIA Parakeet (about 640 MB, downloaded from GitHub releases).
WHISPER_STT_LIBRARY=faster-whisper
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=8

# Piper voice (fallback TTS, fastest on CPU). No HTTP server is started.
# Change this only together with WHISPER_LANGUAGE.
PIPER_VOICE=en_US-lessac-medium

# Kokoro TTS (default voice of the Assist pipeline). The model ships inside
# the pinned image; nothing is downloaded. Voices are offered to Home
# Assistant through wyoming-kokoro; pick one in the pipeline. American:
# af_heart (best), af_bella, am_michael; British: bf_emma, bm_george.
KOKORO_VERSION=v0.9.0
WYOMING_OPENAI_VERSION=0.8.0
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_VOICES=af_heart af_bella bf_emma am_michael bm_george
KOKORO_CPU_THREADS=8

# The Hermes voice key is not set here: Home Assistant stores it in its own
# integration settings (see README). It lives in hermes/.env as HERMES_VOICE_KEY.
