DOMAIN=lab.rafasmour.com
# Pinned official ROCm image tag (unsloth/unsloth-rocm). The "-studio" tags add the
# Studio web UI and JupyterLab; plain tags are training-only. Bump deliberately.
UNSLOTH_VERSION=v0.1.913-beta-studio
# Unsloth Studio admin password (user "unsloth"). Used on FIRST BOOT only; once
# Studio has stored an account in ./studio it is ignored (change it in the UI).
# Generate: openssl rand -base64 18
UNSLOTH_STUDIO_PASSWORD=CHANGE_ME
# JupyterLab password (internal port 8888, not routed by Traefik).
# Generate: openssl rand -base64 18
JUPYTER_PASSWORD=CHANGE_ME
# Optional Hugging Face token for gated models (huggingface.co/settings/tokens).
HF_TOKEN=
