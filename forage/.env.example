DOMAIN=tomandjerry.mourou.dev

# Forage does not currently publish a container image or release tags. Docker
# builds the upstream source directly; replace main with a commit SHA to pin it.
FORAGE_VERSION=main
FORAGE_IMAGE_TAG=local

# Shared with hermes/FORAGE_API_KEY. Generate with: openssl rand -hex 32
FORAGE_API_KEY=CHANGE_ME

TZ=Etc/UTC
