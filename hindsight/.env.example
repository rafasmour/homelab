# Hindsight agent memory (internal only: no Traefik route, no host port).
# See README.md. No DOMAIN is needed because there is no web route.
DOMAIN=lab.rafasmour.com

# Pinned image tags (api-only SLIM image: no bundled embedder/reranker).
HINDSIGHT_VERSION=1.2.0-slim
PGVECTOR_IMAGE=pgvector/pgvector:0.8.1-pg17
RELAY_IMAGE=nginx:1.30.6-alpine-slim

# PostgreSQL. The password is embedded in a URL: use hex/alphanumeric only
# (generate: openssl rand -hex 24).
HINDSIGHT_DB_NAME=hindsight
HINDSIGHT_DB_USER=hindsight
HINDSIGHT_DB_PASSWORD=CHANGE_ME

# GPU llama.cpp router, reached through the relay (hindsight-relay:8001).
# Same key as llama-cpp/.env LLAMA_API_KEY (copy it; setup-env.sh syncs it).
LLAMA_API_KEY=CHANGE_ME
# The warm model only: any other model id makes the router evict it.
HINDSIGHT_LLM_MODEL=nemotron-3.5-bolt-e4b-dflash
# llama.cpp slot reserved for Hindsight LLM calls (slot 0 is ai-assistant, 2-4
# the other Hermes profiles; see llama-cpp/models/router-config.ini).
HINDSIGHT_LLM_SLOT=1

# CPU llama.cpp router with EmbeddingGemma 2 (768 dimensions, multilingual).
# Hindsight locks the vector dimension on first start: do not change the
# embedding model afterwards without wiping ./postgres.
HINDSIGHT_EMBEDDINGS_MODEL=embeddinggemma-2

# Resource limits.
HINDSIGHT_API_MEM_LIMIT=1536m
HINDSIGHT_DB_MEM_LIMIT=768m
