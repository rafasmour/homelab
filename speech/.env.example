# Voice tester: https://speech.${DOMAIN} (speech-gateway, see README).
DOMAIN=lab.rafasmour.com

# wyoming-parakeet runs in the Wyoming faster-whisper image (sherpa-onnx).
WHISPER_VERSION=3.8.1

# Speech-to-text. The Parakeet model is pre-downloaded into ./parakeet (see
# README "Models"); the server has no internet.
PARAKEET_MODEL=sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8
PARAKEET_CPU_THREADS=8
# Greek Parakeet fine-tune (int8) through wyoming-onnx-asr: retired 2026-11-04
# (Cohere in audio.cpp handles Greek); kept for bringing it back.
ONNX_ASR_VERSION=v0.5.0

# Text-to-speech: audio.cpp server (audiocpp-tts), Vulkan portable build.
# Models go in ./audiocpp/models (see README "Text-to-speech models").
AUDIOCPP_VERSION=v0.9.3
# Host groups that own /dev/dri/card* (video) and /dev/dri/renderD* (render):
#   stat -c '%g %n' /dev/dri/*
VIDEO_GID=44
RENDER_GID=991

# Same value as LLAMA_API_KEY in llama-cpp/.env: speech-gateway's warmer reads
# the router's model status and loads WARM_LLM (see README "Warm models").
LLAMA_API_KEY=CHANGE_ME
# Production llama.cpp preset the warmer keeps loaded (set by
# scripts/production-model.sh together with Hermes, Hindsight and benchmark).
WARM_LLM=nemotron-3.5-bolt-e4b-dflash

# Group id that owns ./recordings (STT_SAVE_DIR): speech-gateway joins it to
# write the captured STT requests there. Default 1000 (the host user's group).
RECORDINGS_GID=1000
