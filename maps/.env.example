DOMAIN=lab.rafasmour.com

# No credentials: the stack has no login of its own and is reachable only over
# WireGuard (see README). Cardinal's "API key" fields stay empty.

# Image tags, pinned. build/build-greece.sh reads the same variables so the
# data is built with the versions that serve it (the Elasticsearch, Valhalla
# and Pelias versions must match between build and runtime).
# nginx serves only the empty libpostal stand-in for Pelias (no web page).
MAPS_NGINX_VERSION=1.30.6-alpine-slim
MAPS_VALHALLA_VERSION=3.9.1
MAPS_PELIAS_API_VERSION=v7.11.0
MAPS_PELIAS_PLACEHOLDER_VERSION=v5.11.0
MAPS_ES_VERSION=7.17.27
# Build-only images (used by build/build-greece.sh, never started by Compose).
MAPS_PELIAS_SCHEMA_VERSION=v10.1.1
MAPS_PELIAS_WHOSONFIRST_VERSION=v9.2.0
MAPS_PELIAS_OPENSTREETMAP_VERSION=v9.5.0
MAPS_PELIAS_POLYLINES_VERSION=v6.2.0

# Owner of maps/data (the build writes as this user; Valhalla, Placeholder and
# Elasticsearch run as it). 1000 is the first user on the homelab.
MAPS_UID=1000
MAPS_GID=1000

# Hard memory limits (the host has 15 GiB and is tight). Idle use is lower;
# see the RAM table in README.md.
MAPS_VALHALLA_MEM_LIMIT=384m
MAPS_PELIAS_API_MEM_LIMIT=256m
MAPS_PELIAS_PLACEHOLDER_MEM_LIMIT=256m
MAPS_ES_MEM_LIMIT=1536m
# Elasticsearch JVM heap (-Xms and -Xmx). Keep it about half of
# MAPS_ES_MEM_LIMIT; 512m is plenty for a Greece-only index.
MAPS_ES_HEAP=512m

# Valhalla worker threads. Each thread keeps its own small tile cache.
MAPS_VALHALLA_THREADS=2
