DOMAIN=lab.rafasmour.com

# Owner of the files the agent writes in /llama-cpp and of the client keys in
# hermes/data (same as HERMES_UID, HERMES_GID in hermes/.env).
HERMES_UID=1000
HERMES_GID=1000

# llama.cpp router API key for sbx-models: same value as LLAMA_API_KEY in
# llama-cpp/.env (and hermes/.env).
LLAMA_API_KEY=CHANGE_ME
# Optional Hugging Face token for gated repositories (sbx-models and
# sbx-hf-models); leave empty otherwise.
HF_TOKEN=

# Containers sbx-models may restart through sbx-socket-proxy (regex alternation).
PROXY_RESTART_CONTAINERS=llama-server|llama-classifier

# Pinned images.
HAPROXY_VERSION=3.2.26-alpine
TESTBED_DOCKER_VERSION=29.9.2-dind

# Resource limits.
SBX_MODELS_CPUS=4
SBX_MODELS_MEMORY=4g
SBX_LLAMACPP_CPUS=2
SBX_LLAMACPP_MEMORY=2g
SBX_HF_MODELS_CPUS=2
SBX_HF_MODELS_MEMORY=2g
TESTBED_CPUS=2
TESTBED_MEMORY=2g

TZ=Europe/Athens
