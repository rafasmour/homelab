#!/bin/sh
# Ask the root-side loop to `git pull --ff-only` /repo and print the result.
# The hermes user cannot write /repo itself; it only drops a request file.
state=/run/repo-pull
before=$(cat "${state}/done" 2>/dev/null || echo 0)
: > "${state}/req/request" || { echo "repo-pull: cannot queue a request" >&2; exit 1; }
i=0
while [ "${i}" -lt 300 ]; do
  now=$(cat "${state}/done" 2>/dev/null || echo 0)
  if [ "${now}" != "${before}" ] && [ ! -e "${state}/req/request" ]; then
    cat "${state}/last.log"
    exit 0
  fi
  sleep 1
  i=$((i + 1))
done
echo "repo-pull: timed out after 300 s; last result:" >&2
cat "${state}/last.log" 2>/dev/null >&2
exit 1
