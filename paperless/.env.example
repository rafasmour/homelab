DOMAIN=lab.rafasmour.com
TZ=Europe/Athens

# Image tags. Paperless-ngx is pinned to a release; bump deliberately and read
# the release notes (database migrations run on start). Gotenberg and Tika
# follow the versions in upstream's docker-compose.postgres-tika.yml.
PAPERLESS_VERSION=3.3.4
PAPERLESS_GPT_VERSION=v0.31.0
POSTGRES_VERSION=18
VALKEY_VERSION=9-alpine
GOTENBERG_VERSION=8.37
TIKA_VERSION=3.3.1.0

# PostgreSQL. Passed as separate variables, never inside a URL.
# Generate with: openssl rand -hex 24   (hex keeps it free of quoting issues)
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=CHANGE_ME

# Django secret key for sessions and signing.
# Generate with: openssl rand -hex 32
PAPERLESS_SECRET_KEY=CHANGE_ME

# Superuser created on first start (an existing user is never changed, so later
# edits here have no effect; change the password in the web UI instead).
# Generate the password with: openssl rand -base64 24
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME
PAPERLESS_ADMIN_MAIL=admin@example.com

# Tesseract OCR. PAPERLESS_OCR_LANGUAGE uses Tesseract codes joined with "+";
# PAPERLESS_OCR_LANGUAGES lists extra Debian tesseract-ocr-* packages
# (space-separated) installed at container start; Greek is not in the image.
PAPERLESS_OCR_LANGUAGE=ell+eng
PAPERLESS_OCR_LANGUAGES=ell

# Resource tuning for the 15 GiB host. TASK_WORKERS x THREADS_PER_WORKER must
# not exceed the CPU cores; one worker keeps peak OCR memory around 2 GiB.
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=2
PAPERLESS_MEM_LIMIT=2g

# UID/GID Paperless runs as. Must be the owner of the Nextcloud data folder
# (www-data = 33 in the official nextcloud image): Paperless chowns everything
# in its consume folder to this UID on start and deletes files after import.
PAPERLESS_USERMAP_UID=33
PAPERLESS_USERMAP_GID=33

# Nextcloud consume folder: <NEXTCLOUD_DATA_DIR>/<NEXTCLOUD_USER>/files/<NEXTCLOUD_CONSUME_FOLDER>.
# NEXTCLOUD_DATA_DIR is a host path relative to this folder. Create the folder
# in Nextcloud before starting Paperless (see README.md).
NEXTCLOUD_DATA_DIR=../nextcloud/html/data
NEXTCLOUD_USER=pi.hole
NEXTCLOUD_CONSUME_FOLDER=Scans
# Seconds between polls of the consume folder (inotify is unreliable here).
PAPERLESS_CONSUMER_POLLING_INTERVAL=30
# true: Scans/<a>/<b>/file.pdf gets the tags "a" and "b".
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=false

# paperless-gpt -----------------------------------------------------------

# Paperless API token for paperless-gpt. Create it after the first start
# (Paperless: profile menu > My Profile > API Auth Token, or
#  docker compose exec paperless-ngx python3 manage.py drf_create_token <admin user>).
# The placeholder lets the stack validate before the token exists.
PAPERLESS_GPT_API_TOKEN=CHANGE_ME


# llama.cpp router API key: the same value as LLAMA_API_KEY in llama-cpp/.env.
LLAMA_API_KEY=CHANGE_ME
PAPERLESS_GPT_OPENAI_BASE_URL=http://llama-server:8080/v1
# Router preset for titles, tags, correspondents, document types and dates.
PAPERLESS_GPT_LLM_MODEL=qwen-3.6-35b-a3b
# Router preset for vision OCR (must be a vision preset with an mmproj).
# Router preset of the OCR model. Xiaomi-OCR-0 (0.8B, 1.8 GiB VRAM) won the Greek
# bill test (0.4 % character error, 10/10 key fields, ~3 s per page); see
# llama-cpp/models/model-eval.md. gemma-4-12b-it-qat-vision also works.
PAPERLESS_GPT_OCR_MODEL=ocr-xiaomi-0
# Language hint in the prompts.
PAPERLESS_GPT_LANGUAGE=Greek
# Tags. MANUAL_TAG = review queue; OCR_TAG = vision OCR for that document;
# AUTO_TAG applies suggestions without review: do not add it by workflow.
PAPERLESS_GPT_MANUAL_TAG=paperless-gpt
PAPERLESS_GPT_OCR_TAG=paperless-gpt-ocr-auto
PAPERLESS_GPT_AUTO_TAG=paperless-gpt-auto
PAPERLESS_GPT_OCR_LIMIT_PAGES=5
# Pace for both the text and the vision model.
PAPERLESS_GPT_REQUESTS_PER_MINUTE=20
# Owner of ./gpt (prompts, settings, history).
PAPERLESS_GPT_PUID=1000
PAPERLESS_GPT_PGID=1000
