version = 1

; Command-line options override these values. This router is CPU-only:
; the image has no Vulkan or CUDA backend, and Compose passes --n-gpu-layers 0.
[*]
n-gpu-layers = 0
threads = 8
threads-batch = 8
parallel = 1
; GGUF context for ggml-org/Laya-GGUF. Encoders have no KV cache, so every
; question in one /v1/systemone request must fit in a single ubatch.
ctx-size = 8192
batch-size = 8192
ubatch-size = 8192

[laya]
model = /models/laya/Laya-Q8_0.gguf

[embeddinggemma-2]
; Google EmbeddingGemma 2 (271M text tower, gemma-embedding2 architecture),
; ggml-org Q8_0. Embeddings only: POST /v1/embeddings with this model name.
; Mean pooling is the GGUF default (pooling_type 1); 768-dim output. It runs
; here on the CPU so embedding requests never evict the GPU router's model.
; The [*] context (8192 tokens, one ubatch) covers a whole chunk per input.
model = /models/embeddinggemma-2/embeddinggemma-2-Q8_0.gguf
embeddings = true
pooling = mean
