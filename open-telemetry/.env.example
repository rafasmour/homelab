# Required by the repository convention; this collector has no public route.
DOMAIN=tomandjerry.mourou.dev

# Stable upstream releases. Update deliberately after reviewing release notes.
OTEL_COLLECTOR_VERSION=0.157.0
DOCKER_SOCKET_PROXY_VERSION=v0.4.2

# Docker Root Dir is /data/docker on this host, so json-file logs are here.
# Verify after moving Docker data with: docker info --format '{{.DockerRootDir}}'
DOCKER_LOG_ROOT=/data/docker/containers

# Resource attribute attached to every collected log record.
HOST_NAME=docker-host
