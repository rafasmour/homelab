DOMAIN=tomandjerry.mourou.dev
# Pin a release; `main` can ship broken database migrations.
OPEN_WEBUI_IMAGE_TAG=v0.11.4

# Sent to llama-server and llama-classifier. Neither enforces auth by default,
# but Open WebUI needs a non-empty value.
OPENAI_API_KEY=CHANGE_ME
# Must match hermes/.env API_SERVER_KEY (at least 16 characters). Used for the
# default profile (/v1) and every specialist profile (/p/<profile>/v1).
HERMES_API_KEY=CHANGE_ME

# Signs login sessions; keeps users logged in across container recreation.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGE_ME

# Login is always on (WEBUI_AUTH=true). Leave signup off. Set true only while
# creating the first admin on an empty database, then set false again and run
# `docker compose up -d`.
ENABLE_SIGNUP=false

# false (default): docker-compose.yml is authoritative and settings saved in
# Admin > Settings last only until the next restart. true: values stored in
# data/webui.db win over the environment.
ENABLE_PERSISTENT_CONFIG=false

# MCP and built-in web search bearer token. Must match web-search/.env
# WEB_SEARCH_MCP_TOKEN. Generate with: openssl rand -hex 32
WEB_SEARCH_MCP_TOKEN=CHANGE_ME
# Must match wger/.env MCP_STATIC_TOKEN.
WGER_MCP_TOKEN=CHANGE_ME
# Must match n8n/.env N8N_MCP_AUTH_TOKEN.
N8N_MCP_TOKEN=CHANGE_ME
# All tokens above are embedded in a JSON string: use only letters, digits and
# -._~+/= (hex from openssl rand -hex 32 is safe). No quotes or backslashes.
