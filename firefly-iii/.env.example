DOMAIN=tomandjerry.mourou.dev
FIREFLY_VERSION=latest
DATA_IMPORTER_VERSION=latest
MARIADB_VERSION=lts
ALPINE_VERSION=3.22
TZ=Etc/UTC
FIREFLY_III_LAYOUT=v2
SITE_OWNER=admin@example.com
DB_DATABASE=firefly
DB_USERNAME=firefly
# Generate with: openssl rand -base64 32
APP_KEY=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Must be exactly 32 alphanumeric characters.
STATIC_CRON_TOKEN=CHANGE_ME_32_CHARACTERS_LONG_NOW

# Create a public OAuth client in Firefly III at /profile/oauth. Use
# https://firefly-importer.tomandjerry.mourou.dev/callback as its redirect URL
# and leave "Confidential" unchecked. Then set its numeric client ID here.
FIREFLY_III_CLIENT_ID=
# Alternative to FIREFLY_III_CLIENT_ID: create a Personal Access Token at
# /profile/oauth. Set exactly one authentication method; keep tokens secret.
FIREFLY_III_ACCESS_TOKEN=
