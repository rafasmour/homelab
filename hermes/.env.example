DOMAIN=lab.rafasmour.com

# Container tags. Pin these to a release tag if you require reproducible upgrades.
HERMES_AGENT_VERSION=latest

# UID/GID used by the API container for the Hermes state volume.
# Find these with: id -u && id -g
HERMES_UID=1000
HERMES_GID=1000

# Must be at least 16 characters. Generate with: openssl rand -hex 32
API_SERVER_KEY=CHANGE_ME
# Model id advertised by the bare /v1/models route (the default profile).
# Specialists are served at /p/<profile>/v1 and advertise their profile name.
API_SERVER_MODEL_NAME=hermes-agent

# OpenAI-compatible llama.cpp endpoint. Hermes queries its /models catalog at startup.
HERMES_INFERENCE_BASE_URL=http://llama-cpp:8080/v1

# Model for chat, Kanban workers, and every cron job (one model, so the
# llama.cpp router never swaps between chat and cron). Must be a llama.cpp
# alias. Leave empty to select the first model returned by llama.cpp.
HERMES_MODEL=nemotron-3.5-bolt-e4b-dflash
# Context Hermes plans for (it compacts at HERMES_COMPRESSION_THRESHOLD):
# every profile and cron job HERMES_CONTEXT_LENGTH; the interactive
# HERMES_SESSION_PROFILES HERMES_SESSION_CONTEXT_LENGTH. Both must fit the
# preset's per-slot size (nemotron-3.5-bolt-e4b-dflash: 5 x 64k slots, the
# model's advertised context; see llama-cpp/models/router-config.ini).
HERMES_CONTEXT_LENGTH=65536
HERMES_SESSION_PROFILES=ai-assistant
HERMES_SESSION_CONTEXT_LENGTH=65536
# Fraction of the context at which Hermes compacts the conversation. Hermes'
# 0.5 default (32k) is below the default profile's first call (~35-38k tokens).
# 0.8 = ~52k of 64k, leaving ~13k for the reply and tool output.
HERMES_COMPRESSION_THRESHOLD=0.8
# Profile whose first-call prompt (system prompt + tool schemas) is kept warm in
# llama.cpp (prompt_prime plugin). ai-assistant is the owner's everyday profile (Hermes-Relay);
# that profile needs one API session once so its template file exists.
HERMES_PRIME_PROFILE=ai-assistant
# llama.cpp slot reservation (nemotron-3.5-bolt-e4b-dflash, 5 slots): the primed
# profile always runs in HERMES_SLOT_PRIMED (its prompt stays cached); every
# other profile and cron job gets a fixed slot from HERMES_SLOT_OTHERS (a slot,
# a range spread round-robin over the profiles, or -1 = no pin). Hindsight is
# pinned to slot 1 (hindsight/.env HINDSIGHT_LLM_SLOT).
HERMES_SLOT_PRIMED=0
HERMES_SLOT_OTHERS=2
# ai-assistant only: thinking budget in tokens (-1 = unlimited; 1024 is ~16 s at 63 tok/s).
# Every other profile thinks without a limit.
HERMES_AI_ASSISTANT_THINK_BUDGET=1024

# ask_agent (plugins/agents): one profile asks another and waits this many
# seconds (120) for the answer; a later answer is posted to the Talk home room.
HERMES_ASK_AGENT_WAIT=120
# Hard time limit of one consult in seconds; the consult is killed after it.
HERMES_ASK_AGENT_HARD_CAP=1800
# Longest answer (characters) handed back to the asking profile.
HERMES_ASK_AGENT_MAX_CHARS=8000
# Sampling for every profile except default, sent with each llama.cpp request
# (replaces the model preset's value; presence-penalty 1.5 in a preset made small
# models drop repeated tool arguments). Leave a variable empty to keep the preset's own.
HERMES_SAMPLING_TEMPERATURE=0.6
HERMES_SAMPLING_PRESENCE_PENALTY=0

# Self-hosted Hindsight memory (hindsight stack, start it first). One shared bank
# "hermes", each memory tagged profile:<name>. Empty = built-in MEMORY.md/USER.md only.
HERMES_MEMORY_PROVIDER=hindsight
# Space-separated profiles that never use Hindsight (self-heal boundary, CLI
# sandboxes that cannot reach the hindsight network).
HERMES_MEMORY_EXCLUDE=devops-diagnose coding devops
# Retain the conversation to Hindsight every N user turns. The gateway builds a new
# agent per message and the turn counter is per agent, so any N above 1 never fires.
HERMES_HINDSIGHT_RETAIN_EVERY=1

# IANA time zone for Hermes' clock and the cron scheduler. Cron expressions
# in start.sh are wall-clock times in this zone.
HERMES_TIMEZONE=Europe/Athens

# Must match web-search/WEB_SEARCH_MCP_TOKEN. Generate with: openssl rand -hex 32
WEB_SEARCH_MCP_TOKEN=CHANGE_ME

# Must match n8n/N8N_MCP_AUTH_TOKEN. Generate with: openssl rand -hex 32
N8N_MCP_AUTH_TOKEN=CHANGE_ME

# Must match wger/MCP_STATIC_TOKEN. The startup script expands it into the
# wger MCP Authorization header. Minimum 32 characters. openssl rand -hex 32
MCP_STATIC_TOKEN=CHANGE_ME

# Self-heal (self-heal stack). API key of the devops-diagnose profile only:
# the self-heal controller calls /p/devops-diagnose/v1 with it, and the shared
# API_SERVER_KEY is not accepted there. At least 16 characters and different
# from API_SERVER_KEY, otherwise devops-diagnose is not served.
# Must equal self-heal/SELF_HEAL_HERMES_KEY. Generate with: openssl rand -hex 32
SELF_HEAL_HERMES_KEY=CHANGE_ME
# Must equal self-heal/DIAGNOSE_MCP_TOKEN. Generate with: openssl rand -hex 32
DIAGNOSE_MCP_TOKEN=CHANGE_ME
# Optional: bearer token of benchmark-mcp (benchmark stack), for the models
# profile. Must equal benchmark/BENCHMARK_MCP_TOKEN. Generate with: openssl rand -hex 32
# Empty: the models profile does not get the benchmark tools.
BENCHMARK_MCP_TOKEN=CHANGE_ME

# The voice profile and its HERMES_VOICE_KEY were removed on 2026-11-06 (Home
# Assistant retired). An existing HERMES_VOICE_KEY line in .env is now unused
# and can be deleted.

# Nextcloud Talk delivery through hermes-nextcloud-bridge (cron jobs use
# --deliver nextcloud_talk; agents use the talk_send tool).
NEXTCLOUD_TALK_DELIVER_URL=http://hermes-nextcloud-bridge:8788/deliver
# Must match hermes-nextcloud-bridge/TALK_DELIVER_SECRET. openssl rand -hex 32
NEXTCLOUD_TALK_DELIVER_SECRET=CHANGE_ME
# Token of the Talk room the bot posts to: the last path segment of the room
# URL (https://nextcloud.<DOMAIN>/call/<token>). See hermes-nextcloud-bridge/README.md.
NEXTCLOUD_TALK_HOME_ROOM=CHANGE_ME

# One Talk room per profile, "profile=room-token|...", identical in
# hermes/.env and hermes-nextcloud-bridge/.env. Profiles without an entry use
# the home room. See hermes-nextcloud-bridge/README.md for creating the rooms.
NEXTCLOUD_TALK_PROFILE_ROOMS=default=CHANGE_ME|nextcloud=CHANGE_ME|finance=CHANGE_ME|calories=CHANGE_ME|ai-news=CHANGE_ME|hf-models=CHANGE_ME|llamacpp-vulkan=CHANGE_ME|selfhosted=CHANGE_ME|llamacpp-rocm=CHANGE_ME|models=CHANGE_ME|planner=CHANGE_ME|n8n=CHANGE_ME|web-search=CHANGE_ME


# llama.cpp router API key: same value as LLAMA_API_KEY in llama-cpp/.env.
LLAMA_API_KEY=CHANGE_ME

# Hermes-Relay (Android app, https://github.com/Codename-11/hermes-relay).
# start.sh runs the Hermes web dashboard (hermes-dash.<DOMAIN>) and the relay
# (hermes-relay.<DOMAIN>) next to the gateway. Set either switch to false to
# skip it. Both hostnames must stay behind the VPN (WireGuard) like the rest
# of the stack.
HERMES_DASHBOARD_ENABLED=true
# Dashboard login. The dashboard refuses a non-loopback bind without it, so
# start.sh serves the dashboard only when the password is set and not
# CHANGE_ME. Generate with: openssl rand -base64 24
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME
HERMES_RELAY_ENABLED=true
# Relay terminal: an interactive shell as the hermes user INSIDE hermes-api,
# which holds every secret of this stack. Leave false unless you accept that
# a paired phone is root-equivalent for the whole homelab (see README).
HERMES_RELAY_TERMINAL_ENABLED=false

# Speech for every profile through the speech stack's gateway (see
# speech/README.md). STT "auto": Parakeet, Greek Parakeet for Greek. TTS:
# any engine the gateway lists (assistant = Jarvis for English, Spyros for
# Greek; jarvis, supertonic, omnivoice, voxcpm2, pocket-greek, ...)
# and one of its voices. Empty HERMES_SPEECH_URL keeps Hermes' defaults.
HERMES_SPEECH_URL=http://speech-gateway:8000/v1
HERMES_STT_MODEL=auto
HERMES_TTS_MODEL=assistant
HERMES_TTS_VOICE=assistant
