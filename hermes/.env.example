DOMAIN=lab.rafasmour.com

# This file is also mounted read-only as the .env of every gateway-served
# profile (data/profiles/<name>/.env): the multiplexed gateway resolves the
# ${VAR} placeholders of a profile's config.yaml from that profile's own .env,
# not from the container environment. Keep it plain KEY=value lines (no
# `export`, no ${...} inside values), and set every variable that a profile
# file references: HERMES_INFERENCE_BASE_URL, HERMES_MODEL, LLAMA_API_KEY,
# WEB_SEARCH_MCP_TOKEN, N8N_MCP_AUTH_TOKEN, MCP_STATIC_TOKEN, API_SERVER_KEY.

# Agent image tag, pinned: the Dockerfile (relay and Hindsight plugin pins and
# patches) and profiles/*/config.yaml are checked against this release.
# Rebuild after changing it: docker compose up -d --build hermes
HERMES_AGENT_VERSION=v0.23.2

# UID/GID used by the API container for the Hermes state volume.
# Find these with: id -u && id -g
HERMES_UID=1000
HERMES_GID=1000

# Must be at least 16 characters. Generate with: openssl rand -hex 32
API_SERVER_KEY=CHANGE_ME
# Model id advertised by the bare /v1/models route (the default profile).
# Specialists are served at /p/<profile>/v1 and advertise their profile name.
API_SERVER_MODEL_NAME=hermes-agent

# OpenAI-compatible llama.cpp endpoint. Required: profiles read it as
# ${HERMES_INFERENCE_BASE_URL}.
HERMES_INFERENCE_BASE_URL=http://llama-cpp:8080/v1

# Model for chat, Kanban workers, every cron job and every auxiliary task (one
# model, so the llama.cpp router never swaps between chat and cron). Required;
# must be a llama.cpp alias. There is no auto-detection any more.
HERMES_MODEL=nemotron-3.5-bolt-e4b-dflash

# Everything else that used to be an environment variable now lives in the
# versioned profile files (change it there and recreate the container):
#   profiles/_base/config.yaml     context length (65536), compaction threshold
#                                  (0.8), time zone, Hindsight on, speech URL
#                                  and STT/TTS model and voice
#   profiles/<name>/config.yaml    llama.cpp slot (ai-assistant 0, others 2),
#                                  sampling (temperature 0.6, presence 0),
#                                  ai-assistant thinking budget (1024)
#   profiles/<name>/hindsight.json Hindsight settings (retain tags and mode)

# Must match web-search/WEB_SEARCH_MCP_TOKEN. Generate with: openssl rand -hex 32
WEB_SEARCH_MCP_TOKEN=CHANGE_ME

# Must match n8n/N8N_MCP_AUTH_TOKEN. Generate with: openssl rand -hex 32
N8N_MCP_AUTH_TOKEN=CHANGE_ME

# Must match wger/MCP_STATIC_TOKEN. Profile configs expand it into the wger MCP
# Authorization header. Minimum 32 characters. openssl rand -hex 32
MCP_STATIC_TOKEN=CHANGE_ME

# llama.cpp router API key: same value as LLAMA_API_KEY in llama-cpp/.env.
LLAMA_API_KEY=CHANGE_ME

# Hermes-Relay (Android app, https://github.com/Codename-11/hermes-relay).
# The web dashboard (hermes-dash.<DOMAIN>) and the relay (hermes-relay.<DOMAIN>)
# run next to the gateway as s6 services of the same container. Set either
# switch to false to turn that service off. Both hostnames must stay behind the
# VPN (WireGuard) like the rest of the stack.
HERMES_DASHBOARD_ENABLED=true
# Login of the dashboard and of the Desktop Webapp (https://hermes.<DOMAIN>).
# The password and the session secret are required; there is no CHANGE_ME
# check any more, so change them before the first start.
# Password: openssl rand -base64 24. Secret (signs the sessions so logins
# survive restarts): openssl rand -hex 32
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME
HERMES_DASHBOARD_SECRET=CHANGE_ME
HERMES_RELAY_ENABLED=true
# Relay terminal: an interactive shell as the hermes user INSIDE hermes,
# which holds every secret of this stack. Leave false unless you accept that
# a paired phone is root-equivalent for the whole homelab (see README).
HERMES_RELAY_TERMINAL_ENABLED=false

# Traefik's webgateway subnet for the Desktop Webapp: one bounded CIDR
# (unbounded fails closed).
# Check with: docker network inspect webgateway --format '{{(index .IPAM.Config 0).Subnet}}'
HERMES_TRUSTED_PROXIES=172.20.1.0/24
