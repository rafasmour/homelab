DOMAIN=tomandjerry.mourou.dev

# Container tags. Pin these to a release tag if you require reproducible upgrades.
HERMES_AGENT_VERSION=latest

# UID/GID used by the API container for the Hermes state volume.
# Find these with: id -u && id -g
HERMES_UID=1000
HERMES_GID=1000

# Must be at least 16 characters. Generate with: openssl rand -hex 32
API_SERVER_KEY=CHANGE_ME
# Model id advertised by the bare /v1/models route (the default profile).
# Specialists are served at /p/<profile>/v1 and advertise their profile name.
API_SERVER_MODEL_NAME=hermes-agent

# OpenAI-compatible llama.cpp endpoint. Hermes queries its /models catalog at startup.
HERMES_INFERENCE_BASE_URL=http://llama-cpp:8080/v1

# Model for chat, Kanban workers, and every cron job (one model, so the
# llama.cpp router never swaps between chat and cron). Must be a llama.cpp
# alias. Leave empty to select the first model returned by llama.cpp.
HERMES_MODEL=mellum-2.1-12b-a2.5b

# IANA time zone for Hermes' clock and the cron scheduler. Cron expressions
# in start.sh are wall-clock times in this zone.
HERMES_TIMEZONE=Europe/Athens

# Must match web-search/WEB_SEARCH_MCP_TOKEN. Generate with: openssl rand -hex 32
WEB_SEARCH_MCP_TOKEN=CHANGE_ME

# Must match n8n/N8N_MCP_AUTH_TOKEN. Generate with: openssl rand -hex 32
N8N_MCP_AUTH_TOKEN=CHANGE_ME

# Must match wger/MCP_STATIC_TOKEN. The startup script expands it into the
# wger MCP Authorization header. Minimum 32 characters. openssl rand -hex 32
MCP_STATIC_TOKEN=CHANGE_ME

# Nextcloud Talk delivery through hermes-nextcloud-bridge (cron jobs use
# --deliver nextcloud_talk; agents use the talk_send tool).
NEXTCLOUD_TALK_DELIVER_URL=http://hermes-nextcloud-bridge:8788/deliver
# Must match hermes-nextcloud-bridge/TALK_DELIVER_SECRET. openssl rand -hex 32
NEXTCLOUD_TALK_DELIVER_SECRET=CHANGE_ME
# Token of the Talk room the bot posts to: the last path segment of the room
# URL (https://nextcloud.<DOMAIN>/call/<token>). See hermes-nextcloud-bridge/README.md.
NEXTCLOUD_TALK_HOME_ROOM=CHANGE_ME
