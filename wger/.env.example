DOMAIN=tomandjerry.mourou.dev
TZ=Europe/Athens
TIME_ZONE=Europe/Athens

# Image tags. Upstream publishes wger/server and the MCP server as latest.
WGER_VERSION=latest
POSTGRES_VERSION=15-alpine
REDIS_VERSION=7-alpine
NGINX_VERSION=stable-alpine
POWERSYNC_VERSION=latest
WGER_MCP_VERSION=latest

# Django secret. 50+ URL-safe characters:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME

# Database. Use hex only. These values are embedded in PS_DATABASE_URI.
# openssl rand -hex 24
POSTGRES_USER=wger
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wger

# PowerSync storage role password, also hex only (embedded in PS_STORAGE_PG_URI).
# openssl rand -hex 24
POWERSYNC_STORAGE_PASSWORD=CHANGE_ME

# RS256 JWK pair, base64url-encoded JSON. Generate after the web container is
# up, paste both lines here, then recreate web, celery, and powersync:
#   docker compose --env-file wger/.env -f wger/docker-compose.yml exec web ./manage.py generate-jwt-keys
# A first boot can instead use a pair generated on the host with the same
# format (kid wger, RS256). Never commit the private key.
JWT_PUBLIC_KEY=CHANGE_ME
JWT_PRIVATE_KEY=CHANGE_ME

# Leave True until the owner account exists, then set False and recreate web.
ALLOW_REGISTRATION=True

CELERY_WORKER_CONCURRENCY=4
WGER_LANGUAGE=en

# Private calorie MCP. Callers send Authorization: Bearer <MCP_STATIC_TOKEN>.
# Minimum 32 characters. openssl rand -hex 32
MCP_STATIC_TOKEN=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# wger Settings -> API key for the owner account. Tools fail until this is a
# real key and wger-mcp is recreated. Presence is enough for the process to start.
WGER_API_KEY=CHANGE_ME
# Tool group that can log a meal and read the day's totals.
MCP_TOOLS=nutrition
