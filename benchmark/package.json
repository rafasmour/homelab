{
  "name": "homelab-benchmark",
  "version": "1.0.0",
  "private": true,
  "description": "Benchmarks llama.cpp router models as the brain of the Hermes agent profiles.",
  "type": "commonjs",
  "scripts": {
    "benchmark": "node --disable-warning=ExperimentalWarning main.js",
    "import": "node --disable-warning=ExperimentalWarning main.js import",
    "test": "node --test test/*.test.js",
    "tts-texts": "node --disable-warning=ExperimentalWarning benchmarks/tts/build-texts.js",
    "rescore": "node --disable-warning=ExperimentalWarning main.js rescore",
    "backfill-versions": "node --disable-warning=ExperimentalWarning main.js backfill-versions"
  },
  "engines": {
    "node": ">=24"
  }
}
