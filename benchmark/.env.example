DOMAIN=lab.rafasmour.com
TZ=Europe/Athens

# Group that owns the host Docker socket: `stat -c %g /var/run/docker.sock`.
# Socket access is root-equivalent on the host.
DOCKER_SOCKET_GID=983
# Owner of the files written to ./reports.
BENCH_UID=1000
BENCH_GID=1000
# Static Docker CLI version baked into the image (download.docker.com/linux/static).
DOCKER_CLI_VERSION=29.0.0

# llama.cpp router API key: the same value as LLAMA_API_KEY in llama-cpp/.env.
LLAMA_API_KEY=CHANGE_ME
LLAMA_URL=http://llama-server:8080

# wger MCP bearer token: the same value as MCP_STATIC_TOKEN in wger/.env.
MCP_STATIC_TOKEN=CHANGE_ME
WGER_MCP_URL=http://wger-mcp:8765/mcp
NEXTCLOUD_MCP_URL=http://nextcloud-mcp:8000/mcp
FIREFLY_MCP_URL=http://firefly-mcp:3000/mcp

# Talk room token of the mock user bench-mock ("Hermes benchmark (mock)", with
# the Hermes bot set up): the last path segment of the room URL. Benchmark runs
# post only here. Empty refuses cases that can send Talk messages, so nothing
# ever reaches the real rooms. Not a secret. See README "Talk isolation".
BENCHMARK_TALK_ROOM=

# Model reloaded after every run (the Hermes production model).
PRODUCTION_MODEL=ornith-1.5-9b-dflash

# Optional: path of the llama.cpp router config read for model metadata
# (file, quant, ctx, KV type). Must exist on the host.
ROUTER_CONFIG_FILE=../llama-cpp/models/router-config.ini

# Job API token (benchmark-mcp -> runner). Generate with: openssl rand -hex 32
BENCH_API_TOKEN=CHANGE_ME
# MCP bearer token (Hermes -> benchmark-mcp). Same value as BENCHMARK_MCP_TOKEN in
# hermes/.env. Generate with: openssl rand -hex 32
BENCHMARK_MCP_TOKEN=CHANGE_ME

# benchmark-ui login page. Any characters work in the password; generate one with
#   openssl rand -base64 24
# Changing either value needs `up -d benchmark-ui` and logs everyone out.
BENCHMARK_UI_USERNAME=admin
BENCHMARK_UI_PASSWORD=CHANGE_ME
