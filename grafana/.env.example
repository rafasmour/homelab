DOMAIN=lab.rafasmour.com
GRAFANA_VERSION=latest
PUID=1000
PGID=1000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Alert notifications to the "Grafana alerts" Nextcloud Talk room.
# Same value as TALK_DELIVER_SECRET in hermes-nextcloud-bridge/.env.
TALK_DELIVER_SECRET=CHANGE_ME
# Token of the "Grafana alerts" Talk room (the part after /call/ in its URL).
TALK_ALERTS_ROOM=CHANGE_ME

# Bearer token for the "Self-heal" contact point (alerts labelled
# self_heal="true" go to http://self-heal:8790/grafana). Must equal
# self-heal/SELF_HEAL_WEBHOOK_SECRET. Generate with: openssl rand -hex 32
SELF_HEAL_WEBHOOK_SECRET=CHANGE_ME

# Bearer token for the "n8n drift runner" contact point (alerts labelled
# n8n_drift_run="true" go to http://n8n-drift-runner:8791/run). Must equal
# n8n-drift-runner/N8N_DRIFT_WEBHOOK_SECRET. Generate with: openssl rand -hex 32
N8N_DRIFT_WEBHOOK_SECRET=CHANGE_ME
