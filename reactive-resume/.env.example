DOMAIN=tomandjerry.mourou.dev
REACTIVE_RESUME_VERSION=latest
POSTGRES_VERSION=17-alpine
TZ=Etc/UTC
POSTGRES_DB=reactive_resume
POSTGRES_USER=reactive_resume
# Use an alphanumeric password because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
# Generate with: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME
FLAG_DISABLE_SIGNUPS=false
# The owner account is created in the browser on first launch.
