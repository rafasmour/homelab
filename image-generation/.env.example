DOMAIN=example.com
SD_SUBDOMAIN=stable-diffusion

# Model path relative to ./models for a complete, single-file checkpoint.
SD_MODEL=sd-v1-5-pruned-emaonly.safetensors

# For split models such as Z-Image, set these three values instead of SD_MODEL.
# SD_DIFFUSION_MODEL=Z-Anime-8steps.q5_0.gguf
# SD_VAE=ae.safetensors
# SD_LLM=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Hybrid Vulkan/CPU execution. Reserve GPU memory for reference-image buffers.
SD_BACKEND=diffusion=vulkan0,te=cpu,vae=vulkan0
SD_MAX_VRAM=7
SD_AUTO_FIT=false
SD_STREAM_LAYERS=false
