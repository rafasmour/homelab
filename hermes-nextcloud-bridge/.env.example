DOMAIN=lab.rafasmour.com

# Upstream bridge commit (https://github.com/robertlmann02/nextcloud-talk-hermes-bridge).
TALK_BRIDGE_REF=b26267ff8ffb02b4e282b032815584163cff5021

# Must equal hermes/HERMES_AGENT_VERSION so the bridge runs the same Hermes
# Agent build as hermes-api on the shared data volume.
HERMES_AGENT_VERSION=latest

# Owner of the hermes_hermes-data volume files (hermes/HERMES_UID, HERMES_GID).
HERMES_UID=1000
HERMES_GID=1000

# Internal Nextcloud URL on the hermes-mcp network.
NEXTCLOUD_URL=http://nextcloud

# Talk bot shared secret, also passed to `occ talk:bot:install`.
# Talk requires 40-128 characters. Generate with: openssl rand -hex 32
TALK_BOT_SECRET=CHANGE_ME

# Bearer token for POST /deliver (cron delivery and the talk_send tool).
# Must equal hermes/NEXTCLOUD_TALK_DELIVER_SECRET. openssl rand -hex 32
TALK_DELIVER_SECRET=CHANGE_ME

# Talk room the bot posts to (the token at the end of the room URL).
# Must equal hermes/NEXTCLOUD_TALK_HOME_ROOM.
NEXTCLOUD_TALK_HOME_ROOM=CHANGE_ME

# One Talk room per profile, "profile=room-token|...", identical in
# hermes/.env and hermes-nextcloud-bridge/.env. Profiles without an entry use
# the home room. See hermes-nextcloud-bridge/README.md for creating the rooms.
NEXTCLOUD_TALK_PROFILE_ROOMS=default=CHANGE_ME|nextcloud=CHANGE_ME|finance=CHANGE_ME|calories=CHANGE_ME|ai-news=CHANGE_ME|hf-models=CHANGE_ME|llamacpp-vulkan=CHANGE_ME|selfhosted=CHANGE_ME|llamacpp-rocm=CHANGE_ME|models=CHANGE_ME|planner=CHANGE_ME|n8n=CHANGE_ME|web-search=CHANGE_ME

# Self-heal approvals (see README "Self-heal room"). Token of the dedicated
# Talk room (last path segment of the room URL); must equal
# self-heal/TALK_SELF_HEAL_ROOM. Messages in that room never run Hermes:
# "/heal approve <RUN_ID> <code>" and "/heal deny <RUN_ID>" are forwarded to
# the self-heal controller. Leave empty to turn the feature off. Never add
# this room to NEXTCLOUD_TALK_PROFILE_ROOMS.
TALK_SELF_HEAL_ROOM=
SELF_HEAL_APPROVE_URL=http://self-heal:8790/approve
# Bearer token for the controller's /approve endpoint. Must equal
# self-heal/SELF_HEAL_APPROVE_SECRET. Generate with: openssl rand -hex 32
SELF_HEAL_APPROVE_SECRET=CHANGE_ME

TALK_BOT_NAME=Hermes
ASSISTANT_NAME=Hermes

# Hermes profile and toolsets used for Talk conversations. clarify is left
# out because `hermes chat -q` is one-shot; follow-up questions are asked in
# the reply and the bridge keeps the room context. clock is a plugin toolset:
# Hermes checks names before it loads plugins and prints a harmless
# "Unknown toolsets: clock", which the bridge strips; the clock tools work.
# Rooms mapped in NEXTCLOUD_TALK_PROFILE_ROOMS use their profile's toolsets.
HERMES_PROFILE=default
HERMES_TOOLSETS=nextcloud,wger,web_search,clock
HERMES_MAX_TURNS=40

HERMES_TIMEZONE=Europe/Athens

# Seconds before a "still working" notice, hard stop, and heartbeat interval.
TALK_BRIDGE_SOFT_TIMEOUT=180
TALK_BRIDGE_HARD_TIMEOUT=1200
TALK_BRIDGE_BACKGROUND_HEARTBEAT=180

# Optional emoji reaction on each received message, for example 👀. Empty disables it.
TALK_RECEIVED_REACTION=
