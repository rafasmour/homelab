DOMAIN=tomandjerry.mourou.dev

WEB_SEARCH_IMAGE_TAG=local

# Shared with hermes/WEB_SEARCH_MCP_TOKEN and openwebui/WEB_SEARCH_MCP_TOKEN.
# Generate with: openssl rand -hex 32
WEB_SEARCH_MCP_TOKEN=CHANGE_ME

SEARXNG_URL=http://searxng:8080

# Implementation selectors. Unset or empty values use the defaults below.
# SEARCH_ENGINE=searxng
# FETCH_HEADERS=curl_recommended
# FETCH_WEBSITE=curl
# EXTRACT_MAIN_CONTENT=trafilatura
# HTML_TO_MARKDOWN=markdownify

WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_PAGE_CHARS=8000
WEB_SEARCH_TOTAL_CHARS=40000
# Search results fetched in parallel by web_search and POST /fetch.
WEB_SEARCH_FETCH_WORKERS=4

# Character cap for fetch_url and each POST /fetch document. The fetch_url
# max_chars argument can lower it but never raise it.
WEB_FETCH_MAX_CHARS=20000

# SSRF guard. false refuses URLs (and redirect hops) that resolve to private,
# loopback, link-local, CGNAT, multicast or reserved addresses, which blocks
# Docker services such as http://nextcloud. Set true only if the tools must
# read internal hosts.
FETCH_ALLOW_PRIVATE=false

TZ=Etc/UTC
