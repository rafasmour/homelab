DOMAIN=lab.rafasmour.com

WEB_SEARCH_IMAGE_TAG=local

# Shared with hermes/WEB_SEARCH_MCP_TOKEN and openwebui/WEB_SEARCH_MCP_TOKEN.
# Generate with: openssl rand -hex 32
WEB_SEARCH_MCP_TOKEN=CHANGE_ME

SEARXNG_URL=http://searxng:8080
# Seconds SearXNG waits for its slowest engine before answering with the
# results it has (sent as ?timeout_limit=, capped by SearXNG's
# outgoing.max_request_timeout). 0 uses SearXNG's own engine timeouts.
SEARXNG_TIMEOUT_LIMIT=3
# Optional comma-separated SearXNG engine names or categories to query instead
# of SearXNG's defaults, e.g. "google cse,bing,mwmbl,wikipedia". Empty uses the
# engines enabled in searxng/config/settings.yml.
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=
# Comma-separated SearXNG engine names to skip for web-search's queries only
# (SearXNG itself and browser users are unaffected). These four answer this
# host with CAPTCHAs, rate limits or access denied; each retry after SearXNG's
# suspension expires used to stall a search until the timeout. Set to "none"
# to query every engine SearXNG has enabled.
SEARXNG_DISABLED_ENGINES=duckduckgo,brave,startpage,wikidata

# Implementation selectors. Unset or empty values use the defaults below.
# SEARCH_ENGINE=searxng
# FETCH_HEADERS=curl_recommended
# FETCH_WEBSITE=curl
# EXTRACT_MAIN_CONTENT=trafilatura
# HTML_TO_MARKDOWN=markdownify

WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_MAX_RESULTS=8
# web_search returns title, URL, snippet and an excerpt of this many characters
# of each result's main text; fetch_url reads a page in full. 0 skips reading
# pages and returns snippets only (fastest).
WEB_SEARCH_EXCERPT_CHARS=1200
# Seconds web_search waits for result pages (one attempt, no retries, redirects
# included). Pages not read in time are listed with their snippet only.
WEB_SEARCH_FETCH_DEADLINE=4
# Pages fetched in parallel by web_search and POST /fetch.
WEB_SEARCH_FETCH_WORKERS=8

# Character cap for fetch_url and each POST /fetch document. The fetch_url
# max_chars argument can lower it but never raise it.
WEB_FETCH_MAX_CHARS=20000

# SSRF guard. false refuses URLs (and redirect hops) that resolve to private,
# loopback, link-local, CGNAT, multicast or reserved addresses, which blocks
# Docker services such as http://nextcloud. Set true only if the tools must
# read internal hosts.
FETCH_ALLOW_PRIVATE=false

# Per-host User-Agent overrides, "host=agent|host=agent" (matches subdomains).
# Empty uses the built-in default, which gives reddit.com a descriptive client
# agent so its RSS feeds answer (browser-like agents get 403 from this host).
FETCH_HOST_USER_AGENTS=

# INFO logs one timing line per web_search call (no query text); DEBUG adds
# one line per page read with its URL.
LOG_LEVEL=INFO

TZ=Etc/UTC
