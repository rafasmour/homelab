DOMAIN=lab.rafasmour.com
TZ=Europe/Athens
PYTHON_VERSION=3.13.17
# UID/GID that own node-exporter/textfile (the runner writes n8n_drift.prom there).
PUID=1000
PGID=1000
# Shared secret Grafana sends as "Authorization: Bearer". Must equal
# grafana/N8N_DRIFT_WEBHOOK_SECRET. Generate with: openssl rand -hex 32
N8N_DRIFT_WEBHOOK_SECRET=CHANGE_ME
# n8n API key with ONLY the workflow:list and workflow:read scopes.
# Create in n8n: Settings > n8n API > Create an API key. Do not reuse the
# full-access N8N_API_KEY of the n8n-mcp container.
N8N_DRIFT_API_KEY=CHANGE_ME
# 1 = when a workflow changed in n8n, export it over its file in n8n/workflows
# (working tree only; review with git diff, then commit or revert). Grafana
# still posts one "changed outside git" alert per export. 0 = only report.
N8N_DRIFT_AUTO_EXPORT=1
