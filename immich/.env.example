DOMAIN=tomandjerry.mourou.dev
TZ=Etc/UTC
IMMICH_VERSION=v3
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Generate with: openssl rand -hex 32
# Use only A-Z, a-z, and 0-9 characters; no symbols or spaces.
DB_PASSWORD=CHANGE_ME

# The first account created in the browser becomes the administrator.
# Set this to false after creating that account, then recreate the server.
IMMICH_ALLOW_SETUP=true
